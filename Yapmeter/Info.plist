<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundleDisplayName</key>
	<string>Yapmeter</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>LSUIElement</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>14.2</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Yapmeter listens to your microphone so it can tell when you are the one speaking and time your turn. Nothing is recorded or sent anywhere. Speech recognition runs only on this Mac, only if you turn it on, and keeps no text.</string>
	<key>NSAudioCaptureUsageDescription</key>
	<string>Yapmeter listens to the audio your meeting app plays so it can tell when the other person is speaking. Nothing is recorded, transcribed, or sent anywhere.</string>
	<key>SUFeedURL</key>
	<string>https://yapmeter.com/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>FdAOu+8JtJq5q3zlSsPgR3y4dMAETjB7pQNMZE0HpWA=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
